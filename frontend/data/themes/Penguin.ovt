/* SPDX-License-Identifier: GPL-2.0-or-later */
@OBSThemeMeta {
    name: 'Penguin Studio';
    id: 'io.github.SigmaCodez.PenguinStudio.Dark';
    extends: 'com.obsproject.Yami';
    author: 'SigmaCodez';
    dark: 'true';
}

@OBSThemeVars {
    /* Charcoal surfaces, violet actions, green signal. */
    --grey1: #66676D;
    --grey2: #515258;
    --grey3: #3B3C42;
    --grey4: #2E2F35;
    --grey5: #25262B;
    --grey6: #202125;
    --grey7: #18191C;
    --grey8: #111214;
    --bg_window: #18191C;
    --bg_base: #202125;
    --bg_preview: #08090A;
    --primary: #795CFF;
    --primary_light: #896DFF;
    --primary_lighter: #AC98FF;
    --primary_dark: #6144DE;
    --primary_darker: #32284E;
    --text: #EDEDF0;
    --text_light: #FFFFFF;
    --text_muted: #A1A1AA;
    --text_disabled: #696A72;
    --border_color: #303137;
    --highlight_color: #9278FF;
    --border_radius: 6px;
    --border_radius_small: 4px;
    --border_radius_large: 8px;
    --padding_container: 8px;
    --padding_menu: 10px;
    --padding_menubar: 7px;
    --padding_wide: 12px;
    --spacing_input: 0px;
    --input_height_base: max(32, calc(var(--font_base_value) * 3));
    --input_padding: 5px;
    --input_text_padding: 8px;
    --input_bg: #111214;
    --input_bg_hover: #202125;
    --input_bg_focus: #202125;
    --input_border: #34353C;
    --input_border_hover: #515258;
    --input_border_focus: #9278FF;
    --button_bg: #25262B;
    --button_bg_hover: #313238;
    --button_bg_down: #202125;
    --button_bg_disabled: #202125;
    --button_border: #3B3C42;
    --button_border_hover: #585960;
    --button_border_focus: #9278FF;
    --list_item_bg_selected: #302B41;
    --list_item_bg_hover: #25262B;
    --tab_bg: #18191C;
    --tab_bg_hover: #25262B;
    --tab_bg_down: #302B41;
    --tab_border: #303137;
    --tab_border_selected: #9278FF;
    --scrollbar_size: 8px;
    --scrollbar_handle: #3B3C42;
    --scrollbar_bg: #18191C;
    --scrollbar_hover: #585960;
    --scrollbar_down: #74747D;
    --palette_alternateBase: #25262B;
    --palette_placeholderText: #91919C;
    --palette_link: #AC98FF;
    --palette_linkVisited: #AC98FF;
}

/* Application chrome and shared navigation. */
QMainWindow, QDialog, QWizard {
    background-color: #18191C;
}
QMainWindow::separator {
    background: #111214;
    width: 3px;
    height: 3px;
}
QMainWindow::separator:hover, QSplitter::handle:hover {
    background: #795CFF;
}
QSplitter::handle {
    background: #111214;
}
QMenuBar {
    background: #111214;
    color: #A1A1AA;
    border-bottom: 1px solid #292A30;
    padding: 2px 5px;
}
QMenuBar::item {
    padding: 4px 8px;
    background: transparent;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background: #2E2F35;
    color: #F6F6F8;
}
QMenu {
    background: #202125;
    border: 1px solid #3B3C42;
    border-radius: 8px;
    padding: 5px;
}
QMenu::item {
    padding: 7px 28px 7px 12px;
    border: 1px solid transparent;
    border-radius: 4px;
}
QMenu::item:selected {
    background: #373042;
    border-color: transparent;
}
QMenu::separator {
    height: 1px;
    background: #34353C;
    margin: 5px 8px;
}
QToolTip {
    background: #2E2F35;
    color: #F6F6F8;
    border: 1px solid #515258;
    border-radius: 4px;
    padding: 6px 9px;
}
QStatusBar, OBSBasicStatusBar {
    background: #111214;
    color: #91919C;
    border-top: 1px solid #292A30;
    margin-top: 0px;
}
QStatusBar::item {
    border: none;
}

/* A single production bar: workspace on the left, output actions on the right. */
#penguinTopBar {
    background: #111214;
    border: none;
    border-bottom: 1px solid #303137;
}
#penguinBrand, #penguinBrandName {
    background: transparent;
    color: #F6F6F8;
    font-size: var(--font_large);
    font-weight: bold;
    border: none;
    padding: 3px 5px;
    icon-size: 28px;
}
#penguinWorkspaceLabel {
    color: #A1A1AA;
    background: transparent;
    padding: 0px 12px;
    border-left: 1px solid #34353C;
}
#penguinMetric {
    background: transparent;
    color: #A1A1AA;
    border: none;
    padding: 5px 8px;
    font-size: var(--font_small);
}
#penguinToolbarButton, #penguinDestinationsButton, #penguinRecordButton,
#penguinClipButton, #penguinLiveButton, #penguinWorkspaceTab {
    min-height: var(--input_height);
    padding: var(--input_padding) 12px;
    margin: 0px;
    border: 1px solid #3B3C42;
    border-radius: 6px;
    background: #18191C;
    color: #EDEDF0;
    font-weight: bold;
    icon-size: 18px;
}
#penguinToolbarButton:hover, #penguinDestinationsButton:hover,
#penguinRecordButton:hover, #penguinClipButton:hover, #penguinWorkspaceTab:hover {
    background: #2E2F35;
    border-color: #585960;
}
#penguinToolbarButton:checked, #penguinToolbarButton:pressed,
#penguinClipButton:checked, #penguinWorkspaceTab:checked {
    background: #302B41;
    border-color: #795CFF;
    color: #E7DFFF;
}
#penguinRecordButton:checked, #penguinRecordButton[active="true"] {
    background: #41272D;
    color: #FFB3BE;
    border-color: #B14D63;
}
#penguinLiveButton:enabled, #streamButton:enabled, #broadcastButton:enabled {
    background: #795CFF;
    color: #FFFFFF;
    border: 1px solid #9278FF;
    font-weight: bold;
}
#penguinLiveButton:enabled:hover, #streamButton:enabled:hover, #broadcastButton:enabled:hover {
    background: #896DFF;
    border-color: #B6A4FF;
}
#penguinLiveButton:enabled:checked, #penguinLiveButton[active="true"],
#streamButton:enabled.state-active, #broadcastButton:enabled.state-active {
    background: #234238;
    color: #A6F0C5;
    border-color: #64CE91;
}
#penguinLiveButton:enabled:pressed, #streamButton:enabled:pressed, #broadcastButton:enabled:pressed {
    background: #6144DE;
}
#penguinToolbarButton:disabled, #penguinRecordButton:disabled,
#penguinDestinationsButton:disabled, #penguinClipButton:disabled, #penguinLiveButton:disabled {
    background: #202125;
    color: #696A72;
    border-color: #303137;
}
/* Reserve the split-menu area in the box model, not over the label. */
#penguinLiveButton, #penguinRecordButton {
    padding-right: 34px;
}
#penguinLiveButton::menu-button, #penguinRecordButton::menu-button {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 22px;
    border: none;
    border-left: 1px solid #515258;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
}
#penguinLiveButton::menu-arrow, #penguinRecordButton::menu-arrow {
    image: url(theme:Dark/collapse.svg);
    width: 10px;
    height: 10px;
}
#penguinToolbarButton::menu-indicator, #penguinPanelAction::menu-indicator {
    image: none;
}
#penguinBrand {
    padding-right: 20px;
}
#penguinBrand::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 6px;
    width: 10px;
    height: 10px;
    image: url(theme:Dark/collapse.svg);
}

/* Flat panel boundaries and clear, compact section headings. */
QDockWidget {
    font-weight: normal;
    background: #18191C;
}
QDockWidget::title {
    background: #18191C;
    color: #E1E1E7;
    padding: 10px 12px;
    border-radius: 0px;
    border-bottom: 1px solid #303137;
    font-weight: bold;
}
OBSDock > QWidget {
    background: #18191C;
    border: none;
    border-radius: 0px;
}
#penguinPanelHeader {
    background: #18191C;
    border: none;
    border-bottom: 1px solid #292A30;
}
#penguinPanelTitle, #penguinSectionHeading {
    color: #E1E1E7;
    background: transparent;
    font-weight: bold;
    padding: 4px 0px;
}
#penguinPanelCount {
    color: #91919C;
    background: #25262B;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: var(--font_small);
}
#penguinPanelAction {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 5px;
    icon-size: 15px;
}
#penguinPanelAction:hover {
    background: #2E2F35;
    border-color: #3B3C42;
}
#penguinPanelAction:pressed {
    background: #373042;
}
#penguinCanvasBar {
    background: #18191C;
    border-bottom: 1px solid #292A30;
}
#penguinCanvasTitle {
    color: #EDEDF0;
    font-weight: bold;
    background: transparent;
}
#penguinCanvasBadge, #penguinCanvasStatus {
    color: #A1A1AA;
    background: #25262B;
    border: 1px solid #34353C;
    border-radius: 4px;
    padding: 3px 7px;
    font-size: var(--font_small);
}
#penguinCanvasMode {
    background: transparent;
    color: #A1A1AA;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 5px 9px;
    icon-size: 15px;
}
#penguinCanvasMode:hover {
    background: #2E2F35;
    color: #EDEDF0;
}
#penguinCanvasMode:checked {
    background: #302B41;
    color: #DFD4FF;
    border-color: #67528F;
}

/* Search and comfortable scene/layer rows in the left navigation rail. */
#penguinSceneSearch, #penguinLayerSearch {
    background: #111214;
    border: 1px solid #303137;
    border-radius: 5px;
    /* The enclosing layout owns spacing so embedded actions stay inside the field. */
    margin: 0px;
    padding: 5px 8px;
}
#penguinSceneSearch:focus, #penguinLayerSearch:focus {
    border-color: #9278FF;
}
#scenes, #sources, SourceTree {
    background: #18191C;
    border: none;
    border-radius: 0px;
    padding: 6px;
}
#scenes::item {
    min-height: 26px;
    padding: 6px 10px;
    margin: 2px 0px;
    border: 1px solid transparent;
    border-radius: 6px;
}
#scenes::item:selected, #scenes::item:selected:hover, #scenes::item:selected:focus {
    background: #302B41;
    border: 1px solid #67528F;
    color: #F6F3FF;
}
#scenes::item:hover {
    background: #25262B;
    border-color: #34353C;
}
SourceTreeItem {
    min-height: 24px;
    padding: 6px;
    border-radius: 5px;
}
SourceTreeItem QLabel {
    color: #D6D6DE;
}
SourceTree::item:selected, QListView::item:selected, QTreeView::item:selected, QTableView::item:selected {
    background: #302B41;
    color: #F6F3FF;
}
QHeaderView::section {
    background: #202125;
    color: #A1A1AA;
    border: none;
    border-bottom: 1px solid #34353C;
    padding: 8px 10px;
    font-weight: bold;
}

/* Shared controls: natural text height remains essential at large font scales. */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateTimeEdit {
    min-height: var(--input_height);
}
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    border: 1px solid #34353C;
    border-radius: 5px;
    background: #111214;
    color: #EDEDF0;
    selection-background-color: #6144DE;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #9278FF;
    background: #202125;
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background: #202125;
    color: #696A72;
    border-color: #292A30;
}
QComboBox::drop-down {
    border-left: 1px solid #34353C;
}
QPushButton {
    min-height: var(--input_height);
    /* Yami caps the content height; allow translated / larger labels to grow. */
    max-height: 16777215px;
    margin: 0px;
    padding: var(--input_padding) 12px;
    text-align: center;
    font-weight: normal;
    border-radius: 6px;
}
QSpinBox, QDoubleSpinBox {
    max-height: 16777215px;
}
QCheckBox, QRadioButton {
    spacing: 8px;
    padding: 3px 0px;
}
QDialogButtonBox QPushButton {
    min-width: 72px;
}
QLabel[penguinHint="true"], #penguinInspectorEmpty {
    padding: 0px;
}
QPushButton:default {
    background: #795CFF;
    border-color: #9278FF;
    color: #FFFFFF;
}
QPushButton:default:hover {
    background: #896DFF;
    border-color: #B6A4FF;
}
QPushButton:focus, QToolButton:focus {
    border-color: #9278FF;
}
QCheckBox::indicator:checked {
    background-color: #795CFF;
    border-color: #9278FF;
}
/* Visibility and lock controls are glyphs, not filled form checkboxes. */
.checkbox-icon::indicator:checked {
    background: transparent;
    border-color: transparent;
}
QGroupBox {
    background: #202125;
    border: 1px solid #303137;
    border-radius: 8px;
    margin-top: 8px;
    padding: 28px 12px 12px;
}
QGroupBox::title {
    color: #E1E1E7;
    subcontrol-origin: margin;
    left: 14px;
    top: 10px;
}
QTabWidget::pane {
    border: 1px solid #303137;
    border-radius: 5px;
    background: #18191C;
}
QTabBar {
    font-size: var(--font_base);
}
QTabBar::tab:top, QTabBar::tab:bottom {
    border-radius: 0px;
}
QTabBar::tab {
    background: #18191C;
    color: #A1A1AA;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
    padding: 8px 14px;
    min-height: 18px;
    margin: 0px;
}
QTabBar::tab:hover {
    color: #EDEDF0;
    background: #25262B;
}
QTabBar::tab:selected {
    color: #F6F3FF;
    background: #202125;
    border: none;
    border-bottom: 2px solid #9278FF;
}
QTabBar::tab:focus {
    background: #302B41;
    border: none;
    border-bottom: 2px solid #AC98FF;
}

/* Settings use the same navigation rail as the production workspace. */
OBSBasicSettings #listWidget {
    background: #111214;
    border: none;
    border-right: 1px solid #303137;
    border-radius: 0px;
    padding: 8px 6px;
}
OBSBasicSettings #listWidget::item {
    min-height: 26px;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 7px 8px;
    margin: 2px 0px;
    color: #A1A1AA;
}
OBSBasicSettings #listWidget::item:hover {
    background: #25262B;
    border-color: #34353C;
    color: #EDEDF0;
}
OBSBasicSettings #listWidget::item:selected,
OBSBasicSettings #listWidget::item:selected:hover,
OBSBasicSettings #listWidget::item:selected:focus {
    background: #302B41;
    color: #F6F3FF;
    border: 1px solid #67528F;
}
OBSBasicSettings #PropertiesContainer {
    background: #18191C;
}
OBSBasicSettings QScrollArea {
    border: none;
}
QDialogButtonBox {
    padding: 8px 0px 0px;
}
QWizard QFrame {
    border-color: #303137;
}

/* Inspector sections, compact transform tools and an intentional empty state. */
#penguinInspector, #penguinInspectorPanel, #penguinInspectorDock,
#inspectorScroll, #inspectorBody, #inspectorContent {
    background: #18191C;
    border: none;
}
#inspectorIdentity {
    background: #202125;
    border: 1px solid #303137;
    border-radius: 7px;
}
#inspectorSourceIcon {
    background: #2E2F35;
    border-radius: 6px;
    padding: 4px;
}
#inspectorSourceName {
    color: #F6F6F8;
    font-weight: bold;
    padding: 0px;
}
#inspectorSourceType, #inspectorSourceSize {
    color: #91919C;
    font-size: var(--font_small);
    padding: 0px;
}
#inspectorCard {
    background: transparent;
    border: none;
    border-top: 1px solid #303137;
    border-radius: 0px;
}
#inspectorSectionTitle, #inspectorCropToggle {
    color: #E1E1E7;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    font-weight: bold;
    padding: 4px 0px;
}
#inspectorCropToggle {
    padding: 5px 2px;
    text-align: left;
}
#inspectorCropToggle:hover {
    background: #25262B;
}
#inspectorCropToggle:focus {
    border-color: #9278FF;
}
#inspectorFieldLabel {
    color: #A1A1AA;
    font-size: var(--font_small);
}
#inspectorEmptyIcon {
    background: #25262B;
    border: 1px solid #3B3C42;
    border-radius: 10px;
    padding: 12px;
}
#inspectorEmptyTitle {
    color: #E1E1E7;
    font-size: var(--font_large);
    font-weight: bold;
}
#inspectorEmptyHint, #penguinInspectorEmpty {
    color: #91919C;
    font-size: var(--font_small);
}
#inspectorAction, QPushButton.inspector-action, QPushButton.inspector-arrange {
    min-height: var(--input_height);
    background: #25262B;
    border: 1px solid #3B3C42;
    color: #E1E1E7;
    padding: var(--input_padding) 10px;
    border-radius: 6px;
}
QPushButton.inspector-arrange {
    padding: var(--input_padding);
    icon-size: 18px;
}
#inspectorAction:hover, QPushButton.inspector-action:hover, QPushButton.inspector-arrange:hover {
    background: #373042;
    border-color: #79659D;
}
QPushButton.inspector-action:disabled, QPushButton.inspector-arrange:disabled {
    color: #696A72;
    border-color: #292A30;
    background: #202125;
}
#inspectorVisible, #inspectorLocked {
    min-height: var(--input_height);
    background: #18191C;
    color: #A1A1AA;
    border: 1px solid #3B3C42;
    border-radius: 5px;
    padding: 5px 8px;
}
#inspectorVisible:checked, #inspectorLocked:checked {
    background: #302B41;
    color: #E7DFFF;
    border-color: #67528F;
}
#inspectorVisible:hover, #inspectorLocked:hover {
    border-color: #9278FF;
}
#inspectorAspectLock {
    background: #25262B;
    border: 1px solid #3B3C42;
    padding: 4px;
    border-radius: 4px;
}
#inspectorAspectLock:checked {
    background: #302B41;
    border-color: #79659D;
}
.inspector-field {
    background: #111214;
    border-color: #34353C;
    color: #EDEDF0;
}

/* Native audio faders remain functional; channels read as a single mixer strip. */
#vMixerScrollArea, #hMixerScrollArea, #vVolumeWidgets, #hVolumeWidgets {
    background: #111214;
    border: none;
}
#vVolumeWidgets VolumeControl {
    background: #18191C;
    border: 1px solid #303137;
    border-radius: 5px;
    padding: 7px 5px;
    margin: 5px 3px;
}
#hVolumeWidgets VolumeControl {
    background: #18191C;
    border: 1px solid #303137;
    border-radius: 5px;
    padding: 6px 8px;
    margin: 3px 5px;
}
VolumeName, VolumeName QLabel {
    background: transparent;
    color: #E1E1E7;
    font-size: var(--font_small);
    font-weight: bold;
}
VolumeName {
    padding: 5px 3px;
    border-radius: 4px;
}
VolumeName:hover {
    background: #2E2F35;
    border-color: #515258;
}
VolumeControl #volLabel {
    color: #A1A1AA;
    font-size: var(--font_small);
}
VolumeControl .mixer-category {
    color: #91919C;
    background: transparent;
    font-size: var(--font_xsmall);
    border: none;
}
VolumeMeter {
    background: #18191C;
    color: #74747D;
    qproperty-backgroundNominalColor: #193023;
    qproperty-foregroundNominalColor: #64CE91;
    qproperty-backgroundWarningColor: #443B23;
    qproperty-foregroundWarningColor: #E8C76A;
    qproperty-backgroundErrorColor: #41272D;
    qproperty-foregroundErrorColor: #F27D91;
    qproperty-majorTickColor: #91919C;
    qproperty-minorTickColor: #585960;
}
QSlider::groove:horizontal {
    height: 4px;
    background: #111214;
    border: none;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: #9278FF;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    width: 10px;
    margin: -4px 0px;
    background: #E1E1E7;
    border: 1px solid #91919C;
    border-radius: 3px;
}
#vVolumeWidgets VolumeControl QSlider::groove:vertical {
    width: 4px;
    background: #08090A;
    border-radius: 2px;
}
QSlider::add-page:vertical {
    background: #74747D;
    border-radius: 2px;
}
QSlider::handle:vertical {
    height: 7px;
    margin: 0px -5px;
    background: #E1E1E7;
    border: 1px solid #91919C;
    border-radius: 2px;
}
QSlider::handle:hover {
    background: #FFFFFF;
    border-color: #AC98FF;
}
QSlider::handle:disabled {
    background: #696A72;
    border-color: #3B3C42;
}
VolumeControl .btn-mute, VolumeControl .btn-monitor {
    background: #25262B;
    border: 1px solid #3B3C42;
    border-radius: 4px;
}
VolumeControl .btn-mute.checked {
    background: #41272D;
    border-color: #B14D63;
}
VolumeControl .btn-monitor.checked {
    background: #234238;
    border-color: #64CE91;
}

/* Destinations and platform tools share the inspector's sidebar surface. */
#penguinOutputPanel, #penguinPlatformPanel, #penguinPlatformScroll,
#penguinPlatformScroll > QWidget > QWidget {
    background: #18191C;
    border: none;
}
#penguinDestinationList {
    background: #18191C;
    border: none;
    outline: none;
    padding: 2px 0px;
}
#penguinDestinationHeading {
    color: #EDEDF0;
    font-weight: bold;
    background: transparent;
}
#penguinDestinationCount {
    color: #A1A1AA;
    background: #25262B;
    border-radius: 4px;
    padding: 3px 7px;
    font-size: var(--font_small);
}
#penguinDestinationEmptyTitle {
    color: #E1E1E7;
    font-size: var(--font_large);
    font-weight: bold;
}
QLabel[penguinHint="true"] {
    color: #A1A1AA;
    background: transparent;
    font-size: var(--font_small);
}
QPushButton[penguinPrimary="true"] {
    background: #795CFF;
    color: #FFFFFF;
    border: 1px solid #9278FF;
    border-radius: 6px;
    padding: var(--input_padding) 12px;
    font-weight: bold;
}
QPushButton[penguinPrimary="true"]:hover {
    background: #896DFF;
    border-color: #B6A4FF;
}
QPushButton[penguinPrimary="true"]:pressed {
    background: #6144DE;
}
QPushButton[penguinPrimary="true"]:disabled {
    background: #25262B;
    color: #696A72;
    border-color: #303137;
}
#penguinPlatformTabs::pane {
    background: #18191C;
    border: none;
    border-top: 1px solid #303137;
    border-radius: 0px;
}
#penguinPlatformTabs QTabBar::tab {
    padding: 9px 10px;
}
VolumeControl[penguinChannelStrip="true"] {
    background: #18191C;
    border: 1px solid #303137;
    border-radius: 5px;
    padding: 6px;
    margin: 4px 3px;
}
#penguinDetailsButton, #penguinSettingsButton, #penguinInspectorButton {
    min-height: var(--input_height);
    min-width: var(--input_height);
    padding: var(--input_padding);
    margin: 0px;
    background: transparent;
    color: #A1A1AA;
    border: 1px solid transparent;
    border-radius: 5px;
    icon-size: 18px;
}
#penguinDetailsButton:hover, #penguinSettingsButton:hover, #penguinInspectorButton:hover {
    background: #2E2F35;
    border-color: #3B3C42;
    color: #EDEDF0;
}
#penguinDetailsButton:checked, #penguinInspectorButton:checked {
    background: #302B41;
    border-color: #67528F;
    color: #E7DFFF;
}
#penguinDetailsButton:focus, #penguinSettingsButton:focus, #penguinInspectorButton:focus {
    border-color: #9278FF;
}

#penguinPlatformStatus {
    background: #25262B;
    color: #D6D6DE;
    border: 1px solid #3B3C42;
    border-radius: 6px;
    padding: 8px 10px;
}

/* Icon-only production actions use the same square hit area. */
#penguinToolbarButton[toolButtonStyle="0"],
#penguinDestinationsButton[toolButtonStyle="0"] {
    min-width: var(--input_height);
    padding: var(--input_padding);
}

/* Chat shares the application control metrics instead of local overrides. */
QWidget[penguinChatPanel="true"] {
    background: #18191C;
}
QListWidget#penguinChatHistory {
    background: #111214;
    border: 1px solid #303137;
    border-radius: 6px;
    padding: 6px;
}
QListWidget#penguinChatHistory::item {
    padding: 0px;
    border: none;
}
