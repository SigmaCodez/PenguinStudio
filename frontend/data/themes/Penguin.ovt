/* SPDX-License-Identifier: GPL-2.0-or-later */
@OBSThemeMeta {
    name: 'Penguin Studio';
    id: 'io.github.SigmaCodez.PenguinStudio.Dark';
    extends: 'com.obsproject.Yami';
    author: 'SigmaCodez';
    dark: 'true';
}

@OBSThemeVars {
    /* Shared workspace language: ink surfaces, soft violet selection, mint signal. */
    --grey1: #727C92;
    --grey2: #495368;
    --grey3: #343D50;
    --grey4: #242C3B;
    --grey5: #202735;
    --grey6: #1C222D;
    --grey7: #151A24;
    --grey8: #11141B;
    --bg_window: #151A24;
    --bg_base: #1C222D;
    --bg_preview: #0B0E14;
    --primary: #8B70F9;
    --primary_light: #9C85FF;
    --primary_lighter: #C5B9FF;
    --primary_dark: #7155DB;
    --primary_darker: #343052;
    --text: #F0F2FA;
    --text_light: #FFFFFF;
    --text_muted: #A6AFC1;
    --text_disabled: #788297;
    --border_color: #292E3A;
    --highlight_color: #B7A7FF;
    --border_radius: 9px;
    --border_radius_small: 6px;
    --border_radius_large: 12px;
    --padding_container: 8px;
    --padding_menu: 10px;
    --padding_menubar: 7px;
    --padding_wide: 12px;
    --spacing_input: 0px;
    --input_height_base: max(32, calc(var(--font_base_value) * 3));
    --input_padding: 5px;
    --input_text_padding: 8px;
    --input_bg: #11141B;
    --input_bg_hover: #1C222D;
    --input_bg_focus: #1C222D;
    --input_border: #343D50;
    --input_border_hover: #495368;
    --input_border_focus: #B7A7FF;
    --button_bg: #202735;
    --button_bg_hover: #293244;
    --button_bg_down: #1C222D;
    --button_bg_disabled: #1C222D;
    --button_border: #343D50;
    --button_border_hover: #59657B;
    --button_border_focus: #B7A7FF;
    --list_item_bg_selected: #343052;
    --list_item_bg_hover: #202735;
    --tab_bg: #151A24;
    --tab_bg_hover: #202735;
    --tab_bg_down: #343052;
    --tab_border: #292E3A;
    --tab_border_selected: #B7A7FF;
    --scrollbar_size: 8px;
    --scrollbar_handle: #343D50;
    --scrollbar_bg: #151A24;
    --scrollbar_hover: #59657B;
    --scrollbar_down: #8591A8;
    --palette_alternateBase: #202735;
    --palette_placeholderText: #929AAF;
    --palette_link: #C5B9FF;
    --palette_linkVisited: #C5B9FF;
}

/* Application chrome and shared navigation. */
QMainWindow, QDialog, QWizard {
    background-color: #151A24;
}
QMainWindow::separator {
    background: #11141B;
    width: 6px;
    height: 6px;
}
QMainWindow::separator:hover, QSplitter::handle:hover {
    background: #8B70F9;
}
QSplitter::handle {
    background: #11141B;
}
QMenuBar {
    background: #11141B;
    color: #A6AFC1;
    border-bottom: 1px solid #292E3A;
    padding: 2px 5px;
}
QMenuBar::item {
    padding: 4px 8px;
    background: transparent;
    border-radius: 6px;
}
QMenuBar::item:selected {
    background: #242C3B;
    color: #F4F5FC;
}
QMenu {
    background: #1C222D;
    border: 1px solid #343D50;
    border-radius: 12px;
    padding: 5px;
}
QMenu::item {
    padding: 7px 28px 7px 12px;
    border: 1px solid transparent;
    border-radius: 6px;
}
QMenu::item:selected {
    background: #302B45;
    border-color: transparent;
}
QMenu::separator {
    height: 1px;
    background: #343D50;
    margin: 5px 8px;
}
QToolTip {
    background: #242C3B;
    color: #F4F5FC;
    border: 1px solid #495368;
    border-radius: 6px;
    padding: 6px 9px;
}
QStatusBar, OBSBasicStatusBar {
    background: #11141B;
    color: #929AAF;
    border-top: 1px solid #292E3A;
    margin-top: 0px;
}
QStatusBar::item {
    border: none;
}

/* A single production bar: workspace on the left, output actions on the right. */
#penguinTopBar {
    background: #11141B;
    border: none;
    border-bottom: 1px solid #292E3A;
}
#penguinBrand, #penguinBrandName {
    background: transparent;
    color: #F4F5FC;
    font-size: var(--font_large);
    font-weight: bold;
    border: none;
    padding: 3px 5px;
    icon-size: 28px;
}
#penguinWorkspaceLabel {
    color: #A6AFC1;
    background: transparent;
    padding: 0px 12px;
    border-left: 1px solid #343D50;
}
#penguinMetric {
    background: transparent;
    color: #A6AFC1;
    border: none;
    padding: 5px 8px;
    font-size: var(--font_small);
}
#penguinToolbarButton, #penguinDestinationsButton, #penguinRecordButton,
#penguinClipButton, #penguinLiveButton, #penguinWorkspaceTab {
    min-height: var(--input_height);
    padding: var(--input_padding) 12px;
    margin: 0px;
    border: 1px solid #343D50;
    border-radius: 9px;
    background: #151A24;
    color: #F0F2FA;
    font-weight: bold;
    icon-size: 18px;
}
#penguinToolbarButton:hover, #penguinDestinationsButton:hover,
#penguinRecordButton:hover, #penguinClipButton:hover, #penguinWorkspaceTab:hover {
    background: #242C3B;
    border-color: #59657B;
}
#penguinToolbarButton:checked, #penguinToolbarButton:pressed,
#penguinClipButton:checked, #penguinWorkspaceTab:checked {
    background: #343052;
    border-color: #8B70F9;
    color: #E5DDFF;
}
#penguinRecordButton:checked, #penguinRecordButton[active="true"] {
    background: #41272D;
    color: #FFB3BE;
    border-color: #B14D63;
}
#penguinLiveButton:enabled, #streamButton:enabled, #broadcastButton:enabled {
    background: #8B70F9;
    color: #FFFFFF;
    border: 1px solid #B7A7FF;
    font-weight: bold;
}
#penguinLiveButton:enabled:hover, #streamButton:enabled:hover, #broadcastButton:enabled:hover {
    background: #9C85FF;
    border-color: #D0C4FF;
}
#penguinLiveButton:enabled:checked, #penguinLiveButton[active="true"],
#streamButton:enabled.state-active, #broadcastButton:enabled.state-active {
    background: #234238;
    color: #A6F0C5;
    border-color: #82D7BA;
}
#penguinLiveButton:enabled:pressed, #streamButton:enabled:pressed, #broadcastButton:enabled:pressed {
    background: #7155DB;
}
#penguinToolbarButton:disabled, #penguinRecordButton:disabled,
#penguinDestinationsButton:disabled, #penguinClipButton:disabled, #penguinLiveButton:disabled {
    background: #1C222D;
    color: #788297;
    border-color: #292E3A;
}
/* Reserve the split-menu area in the box model, not over the label. */
#penguinLiveButton, #penguinRecordButton {
    padding-right: 34px;
}
#penguinLiveButton::menu-button, #penguinRecordButton::menu-button {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 22px;
    border: none;
    border-left: 1px solid #495368;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
}
#penguinLiveButton::menu-arrow, #penguinRecordButton::menu-arrow {
    image: url(theme:Dark/collapse.svg);
    width: 10px;
    height: 10px;
}
#penguinToolbarButton::menu-indicator, #penguinPanelAction::menu-indicator {
    image: none;
}
#penguinBrand {
    padding-right: 20px;
}
#penguinBrand::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 6px;
    width: 10px;
    height: 10px;
    image: url(theme:Dark/collapse.svg);
}

/* Calm panel headers and rounded content cards match the QML navigation. */
QDockWidget {
    font-weight: normal;
    background: #151A24;
}
QDockWidget::title {
    background: #151A24;
    color: #EDF1FA;
    padding: 10px 12px;
    border-radius: 0px;
    border-bottom: 1px solid #292E3A;
    font-weight: bold;
}
OBSDock > QWidget {
    background: #151A24;
    border: none;
    border-radius: 0px;
}
#penguinPanelHeader {
    background: #151A24;
    border: none;
    border-bottom: 1px solid #292E3A;
}
#penguinPanelTitle, #penguinSectionHeading {
    color: #EDF1FA;
    background: transparent;
    font-weight: bold;
    padding: 4px 0px;
}
#penguinPanelCount {
    color: #929AAF;
    background: #202735;
    border-radius: 6px;
    padding: 2px 6px;
    font-size: var(--font_small);
}
#penguinPanelAction {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 5px;
    icon-size: 15px;
}
#penguinPanelAction:hover {
    background: #242C3B;
    border-color: #343D50;
}
#penguinPanelAction:pressed {
    background: #302B45;
}
#penguinCanvasBar {
    background: #151A24;
    border-bottom: 1px solid #292E3A;
}
#penguinCanvasTitle {
    color: #F0F2FA;
    font-weight: bold;
    background: transparent;
}
#penguinCanvasBadge, #penguinCanvasStatus {
    color: #A6AFC1;
    background: #202735;
    border: 1px solid #343D50;
    border-radius: 6px;
    padding: 3px 7px;
    font-size: var(--font_small);
}
#penguinCanvasMode {
    background: transparent;
    color: #A6AFC1;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 5px 9px;
    icon-size: 15px;
}
#penguinCanvasMode:hover {
    background: #242C3B;
    color: #F0F2FA;
}
#penguinCanvasMode:checked {
    background: #343052;
    color: #D8CDFF;
    border-color: #615087;
}

/* Search and comfortable scene/layer rows in the left navigation rail. */
#penguinSceneSearch, #penguinLayerSearch {
    background: #11141B;
    border: 1px solid #292E3A;
    border-radius: 8px;
    /* The enclosing layout owns spacing so embedded actions stay inside the field. */
    margin: 0px;
    padding: 5px 8px;
}
#penguinSceneSearch:focus, #penguinLayerSearch:focus {
    border-color: #B7A7FF;
}
#scenes, #sources, SourceTree {
    background: #151A24;
    border: none;
    border-radius: 0px;
    padding: 6px;
}
#scenes::item {
    min-height: 26px;
    padding: 6px 10px;
    margin: 2px 0px;
    border: 1px solid transparent;
    border-radius: 9px;
}
#scenes::item:selected, #scenes::item:selected:hover, #scenes::item:selected:focus {
    background: #343052;
    border: 1px solid #615087;
    color: #F4F1FF;
}
#scenes::item:hover {
    background: #202735;
    border-color: #343D50;
}
SourceTreeItem {
    min-height: 24px;
    padding: 6px;
    border-radius: 8px;
}
SourceTreeItem QLabel {
    color: #CCD3E2;
}
SourceTree::item:selected, QListView::item:selected, QTreeView::item:selected, QTableView::item:selected {
    background: #343052;
    color: #F4F1FF;
}
QHeaderView::section {
    background: #1C222D;
    color: #A6AFC1;
    border: none;
    border-bottom: 1px solid #343D50;
    padding: 8px 10px;
    font-weight: bold;
}

/* Shared controls: natural text height remains essential at large font scales. */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateTimeEdit {
    min-height: var(--input_height);
}
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    border: 1px solid #343D50;
    border-radius: 8px;
    background: #11141B;
    color: #F0F2FA;
    selection-background-color: #7155DB;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #B7A7FF;
    background: #1C222D;
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background: #1C222D;
    color: #788297;
    border-color: #292E3A;
}
QComboBox::drop-down {
    border-left: 1px solid #343D50;
}
QPushButton {
    min-height: var(--input_height);
    /* Yami caps the content height; allow translated / larger labels to grow. */
    max-height: 16777215px;
    margin: 0px;
    padding: var(--input_padding) 12px;
    text-align: center;
    font-weight: normal;
    border-radius: 9px;
}
QSpinBox, QDoubleSpinBox {
    max-height: 16777215px;
}
QCheckBox, QRadioButton {
    spacing: 8px;
    padding: 3px 0px;
}
QDialogButtonBox QPushButton {
    min-width: 72px;
}
QLabel[penguinHint="true"], #penguinInspectorEmpty {
    padding: 0px;
}
QPushButton:default {
    background: #8B70F9;
    border-color: #B7A7FF;
    color: #FFFFFF;
}
QPushButton:default:hover {
    background: #9C85FF;
    border-color: #D0C4FF;
}
QPushButton:focus, QToolButton:focus {
    border-color: #B7A7FF;
}
QCheckBox::indicator:checked {
    background-color: #8B70F9;
    border-color: #B7A7FF;
}
/* Visibility and lock controls are glyphs, not filled form checkboxes. */
.checkbox-icon::indicator:checked {
    background: transparent;
    border-color: transparent;
}
QGroupBox {
    background: #1C222D;
    border: 1px solid #292E3A;
    border-radius: 12px;
    margin-top: 8px;
    padding: 28px 12px 12px;
}
QGroupBox::title {
    color: #EDF1FA;
    subcontrol-origin: margin;
    left: 14px;
    top: 10px;
}
QTabWidget::pane {
    border: 1px solid #292E3A;
    border-radius: 8px;
    background: #151A24;
}
QTabBar {
    font-size: var(--font_base);
}
QTabBar::tab:top, QTabBar::tab:bottom {
    border-radius: 8px;
}
QTabBar::tab {
    background: #151A24;
    color: #A6AFC1;
    border: none;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 8px 12px;
    min-height: 18px;
    margin: 3px 2px;
}
QTabBar::tab:hover {
    color: #F0F2FA;
    background: #202735;
}
QTabBar::tab:selected {
    color: #F4F1FF;
    background: #343052;
    border: 1px solid #615087;
}
QTabBar::tab:focus {
    background: #343052;
    border: 1px solid #B7A7FF;
}

/* Settings use the same navigation rail as the production workspace. */
OBSBasicSettings #listWidget {
    background: #11141B;
    border: none;
    border-right: 1px solid #292E3A;
    border-radius: 0px;
    padding: 8px 6px;
}
OBSBasicSettings #listWidget::item {
    min-height: 26px;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 7px 8px;
    margin: 2px 0px;
    color: #A6AFC1;
}
OBSBasicSettings #listWidget::item:hover {
    background: #202735;
    border-color: #343D50;
    color: #F0F2FA;
}
OBSBasicSettings #listWidget::item:selected,
OBSBasicSettings #listWidget::item:selected:hover,
OBSBasicSettings #listWidget::item:selected:focus {
    background: #343052;
    color: #F4F1FF;
    border: 1px solid #615087;
}
OBSBasicSettings #PropertiesContainer {
    background: #151A24;
}
OBSBasicSettings QScrollArea {
    border: none;
}
QDialogButtonBox {
    padding: 8px 0px 0px;
}
QWizard QFrame {
    border-color: #292E3A;
}

/* Inspector sections, compact transform tools and an intentional empty state. */
#penguinInspector, #penguinInspectorPanel, #penguinInspectorDock,
#inspectorScroll, #inspectorBody, #inspectorContent {
    background: #151A24;
    border: none;
}
#inspectorIdentity {
    background: #1C222D;
    border: 1px solid #292E3A;
    border-radius: 10px;
}
#inspectorSourceIcon {
    background: #242C3B;
    border-radius: 9px;
    padding: 4px;
}
#inspectorSourceName {
    color: #F4F5FC;
    font-weight: bold;
    padding: 0px;
}
#inspectorSourceType, #inspectorSourceSize {
    color: #929AAF;
    font-size: var(--font_small);
    padding: 0px;
}
#inspectorCard {
    background: #1C222D;
    border: 1px solid #292E3A;
    border-radius: 12px;
    padding: 8px;
}
#inspectorSectionTitle, #inspectorCropToggle {
    color: #EDF1FA;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    font-weight: bold;
    padding: 4px 0px;
}
#inspectorCropToggle {
    padding: 5px 2px;
    text-align: left;
}
#inspectorCropToggle:hover {
    background: #202735;
}
#inspectorCropToggle:focus {
    border-color: #B7A7FF;
}
#inspectorFieldLabel {
    color: #A6AFC1;
    font-size: var(--font_small);
}
#inspectorEmptyIcon {
    background: #202735;
    border: 1px solid #343D50;
    border-radius: 10px;
    padding: 12px;
}
#inspectorEmptyTitle {
    color: #EDF1FA;
    font-size: var(--font_large);
    font-weight: bold;
}
#inspectorEmptyHint, #penguinInspectorEmpty {
    color: #929AAF;
    font-size: var(--font_small);
}
#inspectorAction, QPushButton.inspector-action, QPushButton.inspector-arrange {
    min-height: var(--input_height);
    background: #202735;
    border: 1px solid #343D50;
    color: #EDF1FA;
    padding: var(--input_padding) 10px;
    border-radius: 9px;
}
QPushButton.inspector-arrange {
    padding: var(--input_padding);
    icon-size: 18px;
}
#inspectorAction:hover, QPushButton.inspector-action:hover, QPushButton.inspector-arrange:hover {
    background: #302B45;
    border-color: #8270AB;
}
QPushButton.inspector-action:disabled, QPushButton.inspector-arrange:disabled {
    color: #788297;
    border-color: #292E3A;
    background: #1C222D;
}
#inspectorVisible, #inspectorLocked {
    min-height: var(--input_height);
    background: #151A24;
    color: #A6AFC1;
    border: 1px solid #343D50;
    border-radius: 8px;
    padding: 5px 8px;
}
#inspectorVisible:checked, #inspectorLocked:checked {
    background: #343052;
    color: #E5DDFF;
    border-color: #615087;
}
#inspectorVisible:hover, #inspectorLocked:hover {
    border-color: #B7A7FF;
}
#inspectorAspectLock {
    background: #202735;
    border: 1px solid #343D50;
    padding: 4px;
    border-radius: 6px;
}
#inspectorAspectLock:checked {
    background: #343052;
    border-color: #8270AB;
}
.inspector-field {
    background: #11141B;
    border-color: #343D50;
    color: #F0F2FA;
}

/* Native audio faders remain functional; channels read as a single mixer strip. */
#vMixerScrollArea, #hMixerScrollArea, #vVolumeWidgets, #hVolumeWidgets {
    background: #11141B;
    border: none;
}
#vVolumeWidgets VolumeControl {
    background: #151A24;
    border: 1px solid #292E3A;
    border-radius: 8px;
    padding: 7px 5px;
    margin: 5px 3px;
}
#hVolumeWidgets VolumeControl {
    background: #151A24;
    border: 1px solid #292E3A;
    border-radius: 8px;
    padding: 6px 8px;
    margin: 3px 5px;
}
VolumeName, VolumeName QLabel {
    background: transparent;
    color: #EDF1FA;
    font-size: var(--font_small);
    font-weight: bold;
}
VolumeName {
    padding: 5px 3px;
    border-radius: 6px;
}
VolumeName:hover {
    background: #242C3B;
    border-color: #495368;
}
VolumeControl #volLabel {
    color: #A6AFC1;
    font-size: var(--font_small);
}
VolumeControl .mixer-category {
    color: #929AAF;
    background: transparent;
    font-size: var(--font_xsmall);
    border: none;
}
VolumeMeter {
    background: #151A24;
    color: #8591A8;
    qproperty-backgroundNominalColor: #193023;
    qproperty-foregroundNominalColor: #82D7BA;
    qproperty-backgroundWarningColor: #443B23;
    qproperty-foregroundWarningColor: #E8C76A;
    qproperty-backgroundErrorColor: #41272D;
    qproperty-foregroundErrorColor: #F27D91;
    qproperty-majorTickColor: #929AAF;
    qproperty-minorTickColor: #59657B;
}
QSlider::groove:horizontal {
    height: 4px;
    background: #11141B;
    border: none;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: #B7A7FF;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    width: 10px;
    margin: -4px 0px;
    background: #EDF1FA;
    border: 1px solid #929AAF;
    border-radius: 3px;
}
#vVolumeWidgets VolumeControl QSlider::groove:vertical {
    width: 4px;
    background: #0B0E14;
    border-radius: 2px;
}
QSlider::add-page:vertical {
    background: #8591A8;
    border-radius: 2px;
}
QSlider::handle:vertical {
    height: 7px;
    margin: 0px -5px;
    background: #EDF1FA;
    border: 1px solid #929AAF;
    border-radius: 2px;
}
QSlider::handle:hover {
    background: #FFFFFF;
    border-color: #C5B9FF;
}
QSlider::handle:disabled {
    background: #788297;
    border-color: #343D50;
}
VolumeControl .btn-mute, VolumeControl .btn-monitor {
    background: #202735;
    border: 1px solid #343D50;
    border-radius: 6px;
}
VolumeControl .btn-mute.checked {
    background: #41272D;
    border-color: #B14D63;
}
VolumeControl .btn-monitor.checked {
    background: #234238;
    border-color: #82D7BA;
}

/* Destinations and platform tools share the inspector's sidebar surface. */
#penguinOutputPanel, #penguinPlatformPanel, #penguinPlatformScroll,
#penguinPlatformScroll > QWidget > QWidget {
    background: #151A24;
    border: none;
}
#penguinDestinationList {
    background: #151A24;
    border: none;
    outline: none;
    padding: 2px 0px;
}
#penguinDestinationHeading {
    color: #F0F2FA;
    font-weight: bold;
    background: transparent;
}
#penguinDestinationCount {
    color: #A6AFC1;
    background: #202735;
    border-radius: 6px;
    padding: 3px 7px;
    font-size: var(--font_small);
}
#penguinDestinationEmptyTitle {
    color: #EDF1FA;
    font-size: var(--font_large);
    font-weight: bold;
}
QLabel[penguinHint="true"] {
    color: #A6AFC1;
    background: transparent;
    font-size: var(--font_small);
}
QPushButton[penguinPrimary="true"] {
    background: #8B70F9;
    color: #FFFFFF;
    border: 1px solid #B7A7FF;
    border-radius: 9px;
    padding: var(--input_padding) 12px;
    font-weight: bold;
}
QPushButton[penguinPrimary="true"]:hover {
    background: #9C85FF;
    border-color: #D0C4FF;
}
QPushButton[penguinPrimary="true"]:pressed {
    background: #7155DB;
}
QPushButton[penguinPrimary="true"]:disabled {
    background: #202735;
    color: #788297;
    border-color: #292E3A;
}
#penguinPlatformTabs::pane {
    background: #151A24;
    border: none;
    border-top: 1px solid #292E3A;
    border-radius: 0px;
}
#penguinPlatformTabs QTabBar::tab {
    padding: 9px 10px;
}
VolumeControl[penguinChannelStrip="true"] {
    background: #151A24;
    border: 1px solid #292E3A;
    border-radius: 8px;
    padding: 6px;
    margin: 4px 3px;
}
#penguinDetailsButton, #penguinSettingsButton, #penguinInspectorButton {
    min-height: var(--input_height);
    min-width: var(--input_height);
    padding: var(--input_padding);
    margin: 0px;
    background: transparent;
    color: #A6AFC1;
    border: 1px solid transparent;
    border-radius: 8px;
    icon-size: 18px;
}
#penguinDetailsButton:hover, #penguinSettingsButton:hover, #penguinInspectorButton:hover {
    background: #242C3B;
    border-color: #343D50;
    color: #F0F2FA;
}
#penguinDetailsButton:checked, #penguinInspectorButton:checked {
    background: #343052;
    border-color: #615087;
    color: #E5DDFF;
}
#penguinDetailsButton:focus, #penguinSettingsButton:focus, #penguinInspectorButton:focus {
    border-color: #B7A7FF;
}

#penguinPlatformStatus {
    background: #202735;
    color: #CCD3E2;
    border: 1px solid #343D50;
    border-radius: 9px;
    padding: 8px 10px;
}

/* Icon-only production actions use the same square hit area. */
#penguinToolbarButton[toolButtonStyle="0"],
#penguinDestinationsButton[toolButtonStyle="0"] {
    min-width: var(--input_height);
    padding: var(--input_padding);
}

/* Chat shares the application control metrics instead of local overrides. */
QWidget[penguinChatPanel="true"] {
    background: #151A24;
}
QListWidget#penguinChatHistory {
    background: #11141B;
    border: 1px solid #292E3A;
    border-radius: 9px;
    padding: 6px;
}
QListWidget#penguinChatHistory::item {
    padding: 0px;
    border: none;
}

/* Consistent dialog and popover hierarchy, without fixed text heights. */
QDialog QGroupBox::title { font-weight: bold; }
QAbstractItemView { outline: none; }
QAbstractItemView:focus { border-color: #B7A7FF; }
QComboBox QAbstractItemView {
    background: #1C222D;
    color: #F0F2FA;
    border: 1px solid #495368;
    selection-background-color: #343052;
    selection-color: #F4F1FF;
    padding: 4px;
}
QProgressBar {
    background: #11141B;
    color: #F0F2FA;
    border: 1px solid #343D50;
    border-radius: 6px;
    text-align: center;
}
QProgressBar::chunk { background: #7155DB; border-radius: 5px; }
QScrollBar::handle { border-radius: 4px; }
#penguinPlatformStatus {
    background: #1C222D;
    border-color: #343D50;
    border-radius: 10px;
    padding: 12px;
}
QListWidget#penguinChatHistory { border-radius: 12px; padding: 10px; }
#penguinQuickWorkspace::title { background: #11141B; }
