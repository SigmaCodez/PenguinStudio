{
    "id": "io.github.SigmaCodez.PenguinStudio",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "26.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "penguin-studio",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--device=all",
        "--share=network",
        "--share=ipc",
        "--filesystem=xdg-run/pipewire-0",
        "--filesystem=host",
        "--talk-name=org.kde.StatusNotifierWatcher",
        "--talk-name=org.freedesktop.Flatpak",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.a11y.Bus",
        "--env=VST_PATH=/app/extensions/Plugins/vst",
        "--talk-name=org.freedesktop.secrets",
        "--talk-name=org.kde.kwalletd5",
        "--talk-name=org.kde.kwalletd6"
    ],
    "add-extensions": {
        "org.freedesktop.LinuxAudio.Plugins": {
            "directory": "extensions/Plugins",
            "version": "26.08",
            "add-ld-path": "lib",
            "merge-dirs": "vst",
            "subdirectories": true,
            "no-autodownload": true
        },
        "io.github.SigmaCodez.PenguinStudio.Plugin": {
            "directory": "plugins",
            "subdirectories": true,
            "add-ld-path": "lib",
            "merge-dirs": "lib/obs-modules/plugins;share/obs/obs-modules/plugins;lib/obs-plugins;share/obs/obs-plugins",
            "no-autodownload": true,
            "autodelete": true,
            "versions": "stable;test"
        }
    },
    "modules": [
        {
            "name": "obs-deps-buildstream-base",
            "buildsystem": "simple",
            "build-commands": [
                "tar -xvf base.tar.xz -C /"
            ],
            "sources": [
                {
                    "type": "file",
                    "dest-filename": "base.tar.xz",
                    "url": "https://github.com/obsproject/obs-deps-buildstream/releases/download/2026-09-24/flatpak-base-x86_64-2026-09-24.tar.xz",
                    "sha256": "480a98e55b51566603b6ea0ee28dbeddaefc1e172d18fb72f16ab9d941794c79"
                }
            ]
        },
        {
            "name": "obs-deps-buildstream-devel",
            "buildsystem": "simple",
            "build-commands": [
                "tar -xvf devel.tar.xz -C /"
            ],
            "sources": [
                {
                    "type": "file",
                    "dest-filename": "devel.tar.xz",
                    "url": "https://github.com/obsproject/obs-deps-buildstream/releases/download/2026-09-24/flatpak-devel-x86_64-2026-09-24.tar.xz",
                    "sha256": "c15e10e46054150d927bd81880dfbcc71641658395b84cdaad3f572920481f4a"
                }
            ]
        },
        {
            "name": "obs-deps-buildstream-devtools",
            "buildsystem": "simple",
            "build-commands": [
                "tar -xvf devtools.tar.xz -C /"
            ],
            "cleanup": [
                "*"
            ],
            "sources": [
                {
                    "type": "file",
                    "dest-filename": "devtools.tar.xz",
                    "url": "https://github.com/obsproject/obs-deps-buildstream/releases/download/2026-09-24/flatpak-devtools-x86_64-2026-09-24.tar.xz",
                    "sha256": "f5ba4578cade6bfd3670340e7eeb0f31876b39e29bc978b5ed47da7de03ffc70"
                }
            ]
        },
        {
            "name": "obs-deps-buildstream-qt",
            "buildsystem": "simple",
            "build-commands": [
                "tar -xvf qt.tar.xz -C /"
            ],
            "sources": [
                {
                    "type": "file",
                    "dest-filename": "qt.tar.xz",
                    "url": "https://github.com/obsproject/obs-deps-buildstream/releases/download/2026-09-24/flatpak-qt-x86_64-2026-09-24.tar.xz",
                    "sha256": "7a4060cab48798e13be0eb9aa967dd3cb6f94209c6594eacccf3223c5c91e3de"
                }
            ]
        },
        {
            "name": "qtwebsockets",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_WITH_PCH=OFF",
                "-DQT_BUILD_EXAMPLES=OFF",
                "-DQT_BUILD_TESTS=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.qt.io/official_releases/qt/6.11/6.11.1/submodules/qtwebsockets-everywhere-src-6.11.1.tar.xz",
                    "sha256": "243e3aa11924c8c5c1645e892f62d013caa3766c57512ca926d5b58146646fbf"
                }
            ]
        },
        {
            "name": "cef",
            "build-options": {
                "no-debuginfo": true
            },
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/cef/libcef_dll_wrapper",
                "cp -R ./include /app/cef",
                "cp -R ./Release /app/cef",
                "cp -R ./Resources /app/cef",
                "cp -R ./build/libcef_dll_wrapper/libcef_dll_wrapper.a /app/cef/libcef_dll_wrapper",
                "cp ./LICENSE.txt /app/cef/LICENSE.txt"
            ],
            "cleanup": [
                "/cef"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://cdn-fastly.obsproject.com/downloads/cef_binary_7871_linux_x86_64.tar.xz",
                    "sha256": "8ffc64d06ea74da613eeda7f2aa5d4e98661af6fa3ed8c68724c9a6e4e89ea8e"
                }
            ]
        },
        {
            "name": "qtkeychain",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_WITH_QT6=ON",
                "-DBUILD_TEST_APPLICATION=OFF",
                "-DBUILD_TRANSLATIONS=OFF",
                "-DBUILD_TESTING=OFF",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/frankosterfeld/qtkeychain/archive/refs/tags/0.15.0.tar.gz",
                    "sha256": "f4254dc8f0933b06d90672d683eab08ef770acd8336e44dfa030ce041dc2ca22"
                }
            ],
            "post-install": [
                "install -Dm644 COPYING /app/share/licenses/qtkeychain/COPYING"
            ]
        },
        {
            "name": "penguin-studio",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
                "-DENABLE_NVENC=ON",
                "-DENABLE_WAYLAND=ON",
                "-DENABLE_BROWSER=ON",
                "-DCEF_ROOT_DIR=/app/cef",
                "-DENABLE_ALSA=OFF",
                "-DENABLE_PULSEAUDIO=ON",
                "-DENABLE_JACK=ON",
                "-DENABLE_VLC=OFF",
                "-DENABLE_AJA=ON",
                "-DENABLE_LIBFDK=ON",
                "-DENABLE_QSV11=ON",
                "-DENABLE_DECKLINK=OFF",
                "-DOBS_VERSION_OVERRIDE=33.0.0",
                "-DCMAKE_COMPILE_WARNING_AS_ERROR=OFF",
                "-DFETCHCONTENT_SOURCE_DIR_PENGUIN_ORT=/run/build/penguin-studio/onnxruntime",
                "-DFETCHCONTENT_SOURCE_DIR_PENGUIN_CV=/run/build/penguin-studio/opencv",
                "-DCMAKE_INCLUDE_PATH=/app/include;/usr/include",
                "-DENABLE_FLATPAK=ON"
            ],
            "secret-opts": [
                "-DRESTREAM_CLIENTID=$RESTREAM_CLIENTID",
                "-DRESTREAM_HASH=$RESTREAM_HASH",
                "-DTWITCH_CLIENTID=$TWITCH_CLIENTID",
                "-DTWITCH_HASH=$TWITCH_HASH",
                "-DYOUTUBE_CLIENTID=$YOUTUBE_CLIENTID",
                "-DYOUTUBE_CLIENTID_HASH=$YOUTUBE_CLIENTID_HASH",
                "-DYOUTUBE_SECRET=$YOUTUBE_SECRET",
                "-DYOUTUBE_SECRET_HASH=$YOUTUBE_SECRET_HASH"
            ],
            "post-install": [
                "install -d /app/plugins",
                "install -d /app/extensions/Plugins"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "../"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/microsoft/onnxruntime/releases/download/v1.23.2/onnxruntime-linux-x64-1.23.2.tgz",
                    "sha256": "1fa4dcaef22f6f7d5cd81b28c2800414350c10116f5fdd46a2160082551c5f9b",
                    "dest": "onnxruntime"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/opencv/opencv/archive/refs/tags/4.10.0.tar.gz",
                    "sha256": "b2171af5be6b26f7a06b1229948bbb2bdaa74fcf5cd097e0af6378fce50a6eb9",
                    "dest": "opencv"
                }
            ]
        }
    ]
}
