# Reject dependency packaging configuration before compiling the application.
if(NOT EXISTS "${PACKAGE_CONFIG}")
  message(FATAL_ERROR "Penguin Studio package configuration is missing")
endif()
include("${PACKAGE_CONFIG}")
if(NOT CPACK_PACKAGE_NAME STREQUAL "penguin-studio" OR NOT CPACK_PACKAGE_VERSION STREQUAL PACKAGE_VERSION)
  message(FATAL_ERROR "Package identity/version does not match Penguin Studio ${PACKAGE_VERSION}")
endif()
list(GET CPACK_INSTALL_CMAKE_PROJECTS 0 install_build)
list(GET CPACK_INSTALL_CMAKE_PROJECTS 1 install_project)
if(NOT install_build STREQUAL PACKAGE_BUILD_DIR OR NOT install_project STREQUAL "obs-studio")
  message(FATAL_ERROR "Package must install the full application build, not a dependency")
endif()
message(STATUS "Penguin Studio package identity, version and install project verified")
